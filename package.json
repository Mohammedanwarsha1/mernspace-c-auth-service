{
    "name": "auth-service",
    "version": "1.0.0",
    "description": "The user management service",
    "main": "index.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=production nodemon --legacy-watch --watch src --ext ts,json --exec tsx src/server.ts",
        "build": "tsc",
        "format:fix": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "lint:check": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "jest --no-cache --coverage --all --runInBand",
        "test:watch": "jest --watch --runInBand",
        "prepare": "husky",
        "migration:generate": "typeorm-ts-node-commonjs migration:generate",
        "migration:run": "typeorm-ts-node-commonjs migration:run",
        "migration:create": "typeorm-ts-node-commonjs migration:create"
    },
    "author": "Anwar shah <mohammedanwarsha2019@gmail.com>",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/dotenv": "^6.1.1",
        "@types/eslint__js": "^8.42.3",
        "@types/express": "^5.0.6",
        "@types/http-errors": "^2.0.5",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.6.0",
        "@types/supertest": "^7.2.0",
        "@types/uuid": "^10.0.0",
        "@types/winston": "^2.4.4",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.4",
        "husky": "^9.1.7",
        "jest": "^30.3.0",
        "lint-staged": "^16.4.0",
        "mock-jwks": "^1.0.10",
        "nodemon": "^3.1.14",
        "prettier": "3.8.2",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.2"
    },
    "lint-staged": {
        "*.ts": [
            "npm run format:fix",
            "npm run lint:fix"
        ]
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-jwt": "^8.5.1",
        "express-validator": "^7.2.1",
        "http-errors": "^2.0.1",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^3.2.0",
        "pg": "^8.20.0",
        "reflect-metadata": "^0.2.2",
        "rsa-pem-to-jwk": "^1.1.3",
        "typeorm": "^0.3.28",
        "uuid": "^14.0.0",
        "winston": "^3.19.0"
    }
}
